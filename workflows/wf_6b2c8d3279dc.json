{
  "name": "Welcome · VxDesk tour (safe)",
  "description": "A safe first run: variables, templating, a condition branch, logging, and a screenshot of your desktop saved to runs/. No mouse or keyboard input is performed.",
  "nodes": [
    {
      "id": "n1",
      "type": "trigger.manual",
      "name": "Start",
      "position": {
        "x": 0,
        "y": 120
      },
      "params": {}
    },
    {
      "id": "n2",
      "type": "control.set_variable",
      "name": "Set user",
      "position": {
        "x": 220,
        "y": 120
      },
      "params": {
        "name": "user",
        "value": "VxDesk user"
      }
    },
    {
      "id": "n3",
      "type": "control.log",
      "name": "Say hello",
      "position": {
        "x": 440,
        "y": 120
      },
      "params": {
        "message": "Hello {{ vars.user }}! The VxDesk engine is alive."
      }
    },
    {
      "id": "n4",
      "type": "control.condition",
      "name": "Name long enough?",
      "position": {
        "x": 660,
        "y": 120
      },
      "params": {
        "expression": "len('{{ vars.user }}') > 3"
      }
    },
    {
      "id": "n5",
      "type": "output.save_screenshot",
      "name": "Save screenshot",
      "position": {
        "x": 895,
        "y": 35
      },
      "params": {
        "path": "runs/welcome_shot.png"
      }
    },
    {
      "id": "n6",
      "type": "control.log",
      "name": "Log success",
      "position": {
        "x": 1120,
        "y": 40
      },
      "params": {
        "message": "Condition passed — screenshot saved ({{ n5.output.path }})."
      }
    },
    {
      "id": "n7",
      "type": "control.log",
      "name": "Log failure",
      "position": {
        "x": 900,
        "y": 220
      },
      "params": {
        "message": "Condition failed — this should not happen."
      }
    },
    {
      "id": "n_mtlekf3f1tqml",
      "type": "action.launch",
      "name": "Open Image",
      "position": {
        "x": 1129,
        "y": 135
      },
      "params": {
        "wait_ms": 0,
        "command": "open runs/welcome_shot.png"
      }
    }
  ],
